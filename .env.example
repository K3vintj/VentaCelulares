# Local development uses Vite's /api proxy. Never put Supabase secrets in VITE_*.
VITE_API_URL=/api

# Public browser key for Google Maps JavaScript API only.
# Restrict this key by HTTP referrer and Maps JavaScript API in Google Cloud.
# Never put Supabase service_role, DB passwords, or server secrets in VITE_*.
# VITE_GOOGLE_MAPS_API_KEY=
