# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
DIRECT_URL="postgresql://user:password@localhost:5432/mydb"
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:8443
COOKIE_SECURE=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=products
ADMIN_EMAIL=admin@example.com
# Required only to create the first administrator. No default password is shipped.
ADMIN_INITIAL_PASSWORD=
SEED_DEMO=false
