# Copy privately and complete for the chosen production host; never commit real values.
NODE_ENV=production
PORT=3000
SERVE_FRONTEND=true
FRONTEND_URL=https://YOUR_DOMAIN
COOKIE_SECURE=true
# For Nginx on the same machine. Change only to the actual trusted proxy IP/network.
TRUST_PROXY=loopback
LOG_REQUESTS=true
DATABASE_URL=postgresql://vc_runtime.PROJECT:PASSWORD@POOLER:6543/postgres?sslmode=verify-full
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER:5432/postgres?sslmode=verify-full
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_IN_HOST_SECRET_MANAGER
SUPABASE_STORAGE_BUCKET=products
SEED_DEMO=false
# Operations only. Keep the key in a private file outside the image/repository.
BACKUP_KEY_FILE=/private/ventacelulares-backup.key
BACKUP_DIR=/private/ventacelulares-backups
