{
  "name": "figma-make-app",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "dev:api": "npm --prefix backend run dev",
    "build:all": "npm run check:library && npm run typecheck && npm run build && npm --prefix backend run build",
    "check:library": "node scripts/check-product-library.mjs",
    "prepare:library": "node scripts/prepare-product-library.mjs",
    "test:api": "npm --prefix backend test",
    "test:product-photos": "node --test scripts/tests/product-photo-save.test.mjs",
    "db:verify": "npm --prefix backend run db:verify"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
